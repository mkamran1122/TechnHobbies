rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedEmail() && request.auth.token.email == 'technhobbies268@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidAdminAccount(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == adminId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 254
        && data.role == 'admin'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data, categoryId) {
      return data.keys().hasAll(['id', 'slug', 'name', 'description', 'image', 'featured', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'slug', 'name', 'description', 'image', 'featured', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == categoryId && isValidId(data.id)
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.description is string && data.description.size() <= 500
        && data.image is string && data.image.size() <= 500
        && data.featured is bool
        && data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBrand(data, brandId) {
      return data.keys().hasAll(['id', 'slug', 'name', 'country', 'specialty', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'slug', 'name', 'country', 'specialty', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == brandId && isValidId(data.id)
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.country is string && data.country.size() <= 100
        && data.specialty is string && data.specialty.size() <= 200
        && data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data, productId) {
      return data.keys().hasAll([
          'id', 'slug', 'name', 'brandId', 'categoryId', 'sku', 'price',
          'stockStatus', 'stockCount', 'condition', 'featured', 'published',
          'shortDescription', 'description', 'images', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'slug', 'name', 'brandId', 'categoryId', 'sku', 'price', 'originalPrice',
          'stockStatus', 'stockCount', 'condition', 'featured', 'published', 'archived',
          'shortDescription', 'description', 'images', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == productId && isValidId(data.id)
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 160
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.brandId is string && isValidId(data.brandId)
        && data.categoryId is string && isValidId(data.categoryId)
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64
        && data.price is number && data.price >= 0
        && (!('originalPrice' in data) || (data.originalPrice is number && data.originalPrice >= 0))
        && data.stockStatus in ['In Stock', 'Limited Stock', 'Pre-Order', 'Out of Stock']
        && data.stockCount is number && data.stockCount >= 0
        && data.condition in ['Brand New', 'Open Box', 'Refurbished']
        && data.featured is bool
        && data.published is bool
        && (!('archived' in data) || data.archived is bool)
        && data.shortDescription is string && data.shortDescription.size() <= 400
        && data.description is string && data.description.size() <= 5000
        && data.images is list && data.images.size() >= 1 && data.images.size() <= 10
        && data.images[0] is string && data.images[0].size() >= 1 && data.images[0].size() <= 500
        && data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll([
          'storeName', 'tagline', 'cityBase', 'whatsappNumber',
          'seoTitle', 'seoDescription', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'storeName', 'tagline', 'cityBase', 'whatsappNumber',
          'seoTitle', 'seoDescription', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 120
        && data.tagline is string && data.tagline.size() <= 200
        && data.cityBase is string && data.cityBase.size() <= 120
        && data.whatsappNumber is string && data.whatsappNumber.size() <= 20
        && data.seoTitle is string && data.seoTitle.size() <= 160
        && data.seoDescription is string && data.seoDescription.size() <= 320
        && data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll(['uid', 'email', 'action', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'action', 'createdAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.email is string && data.email == request.auth.token.email && data.email.size() <= 254
        && data.action in ['ADMIN_LOGIN', 'ADMIN_LOGOUT', 'CATALOG_UPDATE']
        && data.createdAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(adminId)
        && isValidAdminAccount(incoming(), adminId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(adminId)
        && isValidAdminAccount(incoming(), adminId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(adminId) && adminId != request.auth.uid;
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(categoryId)
        && isValidCategory(incoming(), categoryId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(categoryId)
        && isValidCategory(incoming(), categoryId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['slug', 'name', 'description', 'image', 'featured', 'updatedBy', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /brands/{brandId} {
      allow get: if isValidId(brandId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(brandId)
        && isValidBrand(incoming(), brandId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(brandId)
        && isValidBrand(incoming(), brandId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['slug', 'name', 'country', 'specialty', 'updatedBy', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(brandId);
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(productId)
        && isValidProduct(incoming(), productId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/categories/$(incoming().categoryId))
        && exists(/databases/$(database)/documents/brands/$(incoming().brandId));
      allow update: if isAdmin() && isValidId(productId)
        && isValidProduct(incoming(), productId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/categories/$(incoming().categoryId))
        && exists(/databases/$(database)/documents/brands/$(incoming().brandId))
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'name', 'brandId', 'categoryId', 'sku', 'price', 'originalPrice',
          'stockStatus', 'stockCount', 'condition', 'featured', 'published', 'archived',
          'shortDescription', 'description', 'images', 'updatedBy', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /store_settings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'public' || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(settingId)
        && isValidStoreSettings(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(settingId)
        && isValidStoreSettings(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'storeName', 'tagline', 'cityBase', 'whatsappNumber',
          'seoTitle', 'seoDescription', 'updatedBy', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /admin_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin() && isValidId(logId)
        && isValidAdminAuditLog(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
