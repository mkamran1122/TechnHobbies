rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Strict single-admin authorization: verified email technhobbies268@gmail.com ONLY.
    // Never trusts /admins/{uid} documents for authorization.
    function isAdmin() {
      return isVerifiedEmail()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'technhobbies268@gmail.com';
    }

    function isValidAdminAccount(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == adminId && data.uid == request.auth.uid && isValidId(data.uid)
        && data.email is string && data.email.lower() == 'technhobbies268@gmail.com'
        && data.role == 'admin'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data, categoryId) {
      return data.keys().hasAll(['id', 'slug', 'name', 'description', 'image', 'featured', 'displayOrder', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'slug', 'name', 'description', 'image', 'featured', 'displayOrder', 'parentId', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == categoryId && isValidId(data.id)
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.description is string && data.description.size() <= 500
        && data.image is string && data.image.size() <= 500
        && data.featured is bool
        && data.displayOrder is number && data.displayOrder >= 0 && data.displayOrder <= 10000
        && (!('parentId' in data) || (data.parentId is string && (data.parentId == '' || (isValidId(data.parentId) && data.parentId != categoryId))))
        && data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBrand(data, brandId) {
      return data.keys().hasAll(['id', 'slug', 'name', 'country', 'specialty', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'slug', 'name', 'country', 'specialty', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == brandId && isValidId(data.id)
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.country is string && data.country.size() <= 100
        && data.specialty is string && data.specialty.size() <= 200
        && data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data, productId) {
      return data.keys().hasAll([
          'id', 'slug', 'name', 'brandId', 'categoryId', 'sku', 'price',
          'stockStatus', 'stockCount', 'condition', 'featured', 'published',
          'archived', 'shortDescription', 'description', 'primaryImage', 'images',
          'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'slug', 'name', 'brandId', 'categoryId', 'subcategoryId', 'sku', 'price', 'originalPrice',
          'discountPercentage', 'stockStatus', 'stockCount', 'condition', 'featured',
          'published', 'archived', 'shortDescription', 'description', 'primaryImage',
          'images', 'specs', 'whatsInBox', 'compatibility', 'variants',
          'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == productId && isValidId(data.id)
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 160
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.brandId is string && isValidId(data.brandId)
        && data.categoryId is string && isValidId(data.categoryId)
        && (!('subcategoryId' in data) || (data.subcategoryId is string && (data.subcategoryId == '' || isValidId(data.subcategoryId))))
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64
        && data.price is number && data.price > 0
        && (!('originalPrice' in data) || (data.originalPrice is number && data.originalPrice >= 0))
        && (!('discountPercentage' in data) || (data.discountPercentage is number && data.discountPercentage >= 0 && data.discountPercentage <= 99))
        && data.stockStatus in ['In Stock', 'Limited Stock', 'Pre-Order', 'Out of Stock']
        && data.stockCount is number && data.stockCount >= 0
        && data.condition in ['Brand New', 'Open Box', 'Refurbished']
        && data.featured is bool
        && data.published is bool
        && data.archived is bool
        && !(data.published == true && data.archived == true)
        && data.shortDescription is string && data.shortDescription.size() <= 400
        && data.description is string && data.description.size() <= 5000
        && data.primaryImage is string && data.primaryImage.size() <= 500
        && data.images is list && data.images.size() <= 10
        && (data.images.size() == 0 || (data.images[0] is string && data.images[0].size() >= 1 && data.images[0].size() <= 500))
        && (!('specs' in data) || (data.specs is list && data.specs.size() <= 40 && (data.specs.size() == 0 || data.specs[0] is map)))
        && (!('whatsInBox' in data) || (data.whatsInBox is list && data.whatsInBox.size() <= 30 && (data.whatsInBox.size() == 0 || data.whatsInBox[0] is string)))
        && (!('compatibility' in data) || (data.compatibility is string && data.compatibility.size() <= 1000))
        && (!('variants' in data) || (data.variants is list && data.variants.size() <= 20 && (data.variants.size() == 0 || data.variants[0] is map)))
        && data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicStoreSettings(data) {
      return data.keys().hasAll([
          'storeName', 'tagline', 'cityBase', 'contactEmail', 'socialLinks',
          'whatsappNumber', 'defaultMessageTemplate', 'primaryButtonLabel',
          'cardButtonLabel', 'showCardInquiryButton', 'seoTitle', 'seoDescription',
          'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'storeName', 'tagline', 'cityBase', 'contactEmail', 'socialLinks',
          'whatsappNumber', 'defaultMessageTemplate', 'primaryButtonLabel',
          'cardButtonLabel', 'showCardInquiryButton', 'seoTitle', 'seoDescription',
          'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 120
        && data.tagline is string && data.tagline.size() <= 200
        && data.cityBase is string && data.cityBase.size() <= 120
        && data.contactEmail is string && data.contactEmail.size() <= 254
        && data.socialLinks is map
        && data.socialLinks.keys().hasAll(['instagram', 'youtube', 'facebook'])
        && data.socialLinks.keys().hasOnly(['instagram', 'youtube', 'facebook'])
        && data.socialLinks.instagram is string && data.socialLinks.instagram.size() <= 500
        && data.socialLinks.youtube is string && data.socialLinks.youtube.size() <= 500
        && data.socialLinks.facebook is string && data.socialLinks.facebook.size() <= 500
        && data.whatsappNumber is string && data.whatsappNumber.size() <= 20
        && data.defaultMessageTemplate is string && data.defaultMessageTemplate.size() <= 1000
        && data.primaryButtonLabel is string && data.primaryButtonLabel.size() <= 80
        && data.cardButtonLabel is string && data.cardButtonLabel.size() <= 80
        && data.showCardInquiryButton is bool
        && data.seoTitle is string && data.seoTitle.size() <= 160
        && data.seoDescription is string && data.seoDescription.size() <= 320
        && data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateAdminSettings(data) {
      return data.keys().hasAll(['trackLocalClicks', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['trackLocalClicks', 'migratedAt', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.trackLocalClicks is bool
        && (!('migratedAt' in data) || (data.migratedAt is string && data.migratedAt.size() <= 64))
        && data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminAuditLog(data) {
      return data.keys().hasAll(['uid', 'email', 'action', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'action', 'createdAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.email is string && data.email.lower() == 'technhobbies268@gmail.com'
        && data.action in ['ADMIN_LOGIN', 'ADMIN_LOGOUT', 'CATALOG_UPDATE']
        && data.createdAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isAdmin() && isValidId(adminId) && adminId == request.auth.uid;
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(adminId)
        && adminId == request.auth.uid
        && isValidAdminAccount(incoming(), adminId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(adminId)
        && adminId == request.auth.uid
        && isValidAdminAccount(incoming(), adminId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']);
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(categoryId)
        && isValidCategory(incoming(), categoryId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(categoryId)
        && isValidCategory(incoming(), categoryId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['slug', 'name', 'description', 'image', 'featured', 'displayOrder', 'parentId', 'updatedBy', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /brands/{brandId} {
      allow get: if isValidId(brandId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(brandId)
        && isValidBrand(incoming(), brandId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(brandId)
        && isValidBrand(incoming(), brandId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['slug', 'name', 'country', 'specialty', 'updatedBy', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(brandId);
    }

    match /products/{productId} {
      allow get: if isValidId(productId)
        && ((existing().published == true && existing().archived == false) || isAdmin());
      allow list: if (existing().published == true && existing().archived == false) || isAdmin();
      allow create: if isAdmin() && isValidId(productId)
        && isValidProduct(incoming(), productId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/categories/$(incoming().categoryId))
        && exists(/databases/$(database)/documents/brands/$(incoming().brandId));
      allow update: if isAdmin() && isValidId(productId)
        && isValidProduct(incoming(), productId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/categories/$(incoming().categoryId))
        && exists(/databases/$(database)/documents/brands/$(incoming().brandId))
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'name', 'brandId', 'categoryId', 'subcategoryId', 'sku', 'price', 'originalPrice',
          'discountPercentage', 'stockStatus', 'stockCount', 'condition', 'featured',
          'published', 'archived', 'shortDescription', 'description', 'primaryImage',
          'images', 'specs', 'whatsInBox', 'compatibility', 'variants',
          'updatedBy', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /store_settings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'public' || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(settingId)
        && (
          (settingId == 'public' && isValidPublicStoreSettings(incoming())) ||
          (settingId == 'admin_private' && isValidPrivateAdminSettings(incoming()))
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(settingId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            settingId == 'public'
            && isValidPublicStoreSettings(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'storeName', 'tagline', 'cityBase', 'contactEmail', 'socialLinks',
              'whatsappNumber', 'defaultMessageTemplate', 'primaryButtonLabel',
              'cardButtonLabel', 'showCardInquiryButton', 'seoTitle', 'seoDescription',
              'updatedBy', 'updatedAt'
            ])
          ) || (
            settingId == 'admin_private'
            && isValidPrivateAdminSettings(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'trackLocalClicks', 'migratedAt', 'updatedBy', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /admin_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(logId)
        && isValidAdminAuditLog(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
