{
  "entities": {
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "Authorized TechnHobbies administrator record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "RC car, drone, aircraft, or hobby hardware item with PKR pricing.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "brandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "price": {
          "type": "number"
        },
        "originalPrice": {
          "type": "number"
        },
        "stockStatus": {
          "type": "string",
          "enum": ["In Stock", "Limited Stock", "Pre-Order", "Out of Stock"]
        },
        "stockCount": {
          "type": "number"
        },
        "condition": {
          "type": "string",
          "enum": ["Brand New", "Open Box", "Refurbished"]
        },
        "featured": {
          "type": "boolean"
        },
        "published": {
          "type": "boolean"
        },
        "archived": {
          "type": "boolean"
        },
        "shortDescription": {
          "type": "string",
          "maxLength": 400
        },
        "description": {
          "type": "string",
          "maxLength": 5000
        },
        "images": {
          "type": "array"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "brandId",
        "categoryId",
        "sku",
        "price",
        "stockStatus",
        "stockCount",
        "condition",
        "featured",
        "published",
        "shortDescription",
        "description",
        "images",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Catalog product category.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "image": {
          "type": "string",
          "maxLength": 500
        },
        "featured": {
          "type": "boolean"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "description",
        "image",
        "featured",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Brand": {
      "title": "Brand",
      "description": "Catalog manufacturer or hobby brand.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "country": {
          "type": "string",
          "maxLength": 100
        },
        "specialty": {
          "type": "string",
          "maxLength": 200
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "country",
        "specialty",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Public storefront SEO, city dispatch label, and WhatsApp number settings.",
      "type": "object",
      "properties": {
        "storeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tagline": {
          "type": "string",
          "maxLength": 200
        },
        "cityBase": {
          "type": "string",
          "maxLength": 120
        },
        "whatsappNumber": {
          "type": "string",
          "maxLength": 20
        },
        "seoTitle": {
          "type": "string",
          "maxLength": 160
        },
        "seoDescription": {
          "type": "string",
          "maxLength": 320
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "storeName",
        "tagline",
        "cityBase",
        "whatsappNumber",
        "seoTitle",
        "seoDescription",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable admin sign-in and catalog audit trail.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "action": {
          "type": "string",
          "enum": ["ADMIN_LOGIN", "ADMIN_LOGOUT", "CATALOG_UPDATE"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "action", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/AdminAccount"
      },
      "description": "Authorized TechnHobbies administrators."
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "TechnHobbies catalog products with PKR pricing."
    },
    "/categories/{categoryId}": {
      "schema": {
        "$ref": "#/entities/Category"
      },
      "description": "TechnHobbies product categories."
    },
    "/brands/{brandId}": {
      "schema": {
        "$ref": "#/entities/Brand"
      },
      "description": "TechnHobbies product brands."
    },
    "/store_settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/StoreSettings"
      },
      "description": "Public storefront display and WhatsApp inquiry settings."
    },
    "/admin_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/AdminAuditLog"
      },
      "description": "Append-only admin audit events."
    }
  }
}
