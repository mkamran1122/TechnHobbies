# VITE_WHATSAPP_BUSINESS_NUMBER: Official WhatsApp Business phone number (digits only with country code, e.g. 923001234567).
# Leave empty until your official business WhatsApp number is assigned.
VITE_WHATSAPP_BUSINESS_NUMBER=""

# VITE_CONTACT_EMAIL: Optional store contact email displayed in the footer when configured.
VITE_CONTACT_EMAIL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
